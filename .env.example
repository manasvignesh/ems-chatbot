# ====================================================================
# EMS ASSISTANT - ENVIRONMENT VARIABLES
# ====================================================================

# Application Settings
APP_NAME="EMS Assistant Backend"
APP_ENV="development" # 'development' | 'staging' | 'production'
DEBUG=false
PORT=8000
HOST="0.0.0.0"

# Google Gemini AI Configuration
# Get your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GOOGLE_EMBEDDING_MODEL="text-embedding-004"

# Supabase / PostgreSQL Configuration with pgvector
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
USE_IN_MEMORY_FALLBACK=true

# EMS Host & Public Endpoint Configuration
EMS_PUBLIC_BASE_URL="https://ems.mlritcie.in"
EMS_PUBLIC_API_URL="https://ems.mlritcie.in/api/public/events"

# CORS Allowed Widget Origins (Comma-separated or JSON list)
ALLOWED_WIDGET_ORIGINS='["http://localhost:3000","http://localhost:5173","http://localhost:8000","https://ems.mlritcie.in","*"]'

# Guardrails & Retrieval Settings
OUT_OF_SCOPE_COOLDOWN_SECONDS=10
MAX_CONVERSATION_HISTORY_MESSAGES=6
MAX_MESSAGE_CHAR_LENGTH=1000
MAX_RETRIEVAL_CHUNKS=6
MIN_SIMILARITY_THRESHOLD=0.35
RATE_LIMIT_REQUESTS_PER_MINUTE=40
